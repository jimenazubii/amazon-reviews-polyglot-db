# Copy this file to .env and adjust the values. .env is git-ignored.
# The defaults below match docker-compose.yml.

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=amazon_reviews

MONGO_URI=mongodb://localhost:27017/
MONGO_DATABASE=amazon_reviews
MONGO_COLLECTION=reviews_texto

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j

# Folder with the *_5.json review files (default: data/ in the repo root)
# DATA_DIR=/path/to/data
BATCH_SIZE=1000
